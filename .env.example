# Server-side Google Gemini API key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Provider abstraction. Keep this as google-veo unless you add another provider.
VIDEO_PROVIDER=google-veo

# Current default. You can pin another compatible Veo model here.
VEO_MODEL=veo-3.1-generate-preview
